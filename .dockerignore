bin/
build/
dist/
tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.log

# Container configuration files
Dockerfile*
.dockerignore
compose*.yml
compose*.yaml
docker-compose*.yml
docker-compose*.yaml
